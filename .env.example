APP_ENV=local
POSTGRES_DB=ai_news
POSTGRES_USER=ai_news
POSTGRES_PASSWORD=ai_news_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
NEWS_WINDOW_HOURS=22

# Publishing Worker (YouTube) -- optional, leave blank until you have
# real Google Cloud OAuth clients. See README.md's Publishing section
# and app/scripts/youtube_oauth_setup.py.
#
# Two fully separate credential sets (different OAuth clients AND
# different destination channels) -- both can be filled in at once;
# YOUTUBE_ENVIRONMENT picks which is actually used, so switching modes
# never means editing secrets back and forth.
YOUTUBE_ENVIRONMENT=dev

YOUTUBE_DEV_CLIENT_ID=
YOUTUBE_DEV_CLIENT_SECRET=
YOUTUBE_DEV_REFRESH_TOKEN=

YOUTUBE_PROD_CLIENT_ID=
YOUTUBE_PROD_CLIENT_SECRET=
YOUTUBE_PROD_REFRESH_TOKEN=
